# ========================================
# 🎮 Gamif.AI Environment Configuration
# ========================================
#
# This is the EXAMPLE/TEMPLATE file for environment variables.
# Copy this file to create your own .env file with actual values.
#
# SETUP INSTRUCTIONS:
# -------------------
# Windows (PowerShell): Copy-Item .env.example .env
# Linux/Mac:            cp .env.example .env
#
# Then edit .env and fill in your actual values.
#
# ⚠️ SECURITY WARNING:
# - NEVER commit .env to Git (it contains secrets)
# - Only commit .env.example (this template file)
# - Always use placeholder values in this file
#
# ========================================
# 📁 Environment Files in This Project
# ========================================
#
# .env.example      - This template file (SAFE to commit)
# .env              - Your active config with real secrets (DO NOT commit)
# .env.development  - Development defaults (SAFE to commit)
# .env.production   - Production defaults (SAFE to commit)
#
# ========================================
# 🔧 Configuration Variables
# ========================================

# ----------------------------------------
# Frontend API Configuration
# ----------------------------------------
# This tells the React frontend where to find the backend API
# IMPORTANT: This must start with VITE_ to be accessible in frontend code

# For local development:
VITE_API_BASE_URL=http://localhost:3001/api

# For GitHub Codespaces (replace with your actual Codespaces URL):
# VITE_API_BASE_URL=https://your-codespace-name-3001.app.github.dev/api

# For production (when frontend and backend are on same domain):
# VITE_API_BASE_URL=/api

# ----------------------------------------
# Backend CORS Configuration
# ----------------------------------------
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing
# This protects your backend from unauthorized access

# For local development (allows both default Vite ports):
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# For GitHub Codespaces (replace with your actual Codespaces URL):
# ALLOWED_ORIGINS=https://your-codespace-name-5173.app.github.dev

# For production (your deployed frontend URL):
# ALLOWED_ORIGINS=https://your-production-domain.com

# ----------------------------------------
# Azure OpenAI Configuration (REQUIRED)
# ----------------------------------------
# This is the API key for Azure OpenAI service
# Used for AI-powered task generation and activity analysis
#
# HOW TO GET YOUR API KEY:
# 1. Go to https://portal.azure.com/
# 2. Navigate to your Azure OpenAI resource
# 3. Click "Keys and Endpoint" in the left menu
# 4. Copy "Key 1" or "Key 2"
# 5. Paste it below (replace the placeholder)

AZURE_OPENAI_API_KEY=your-actual-azure-openai-api-key-here

# ----------------------------------------
# Azure Communication Services - Email (REQUIRED for OTP verification)
# ----------------------------------------
# Used to send OTP verification emails during user registration.
# This requires TWO Azure resources working together:
#
#   1. "Email Communication Services" — the email engine (manages domains & sending)
#   2. "Communication Services" — the API gateway (provides the connection string)
#
# HOW TO SET UP:
# 1. Azure Portal → Create "Email Communication Services" resource (e.g. gamifai-email)
# 2. In that resource → Provision Domains → Add free Azure subdomain
#    → You'll get a verified domain like: <id>.azurecomm.net
#    → The sender address will be: DoNotReply@<id>.azurecomm.net
# 3. Azure Portal → Create "Communication Services" resource (e.g. gamifai-comm)
# 4. In that resource → Email > Domains → Connect Domain
#    → Select the Email Service and verified domain from step 2
# 5. In that resource → Keys → Copy the "Connection string"
# 6. Paste both values below

ACS_CONNECTION_STRING=endpoint=https://your-resource.communication.azure.com/;accesskey=your-access-key
ACS_SENDER_ADDRESS=DoNotReply@your-id.azurecomm.net

# ----------------------------------------
# Additional Azure OpenAI Settings
# ----------------------------------------
# These are configured in the application code:
# - Endpoint: https://gamifai-resource.cognitiveservices.azure.com/
# - Model: gpt-4o-mini
# - Deployment: daily-task-agent
# - API Version: 2024-04-01-preview
#
# If you need to override these, add them here:
# AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_OPENAI_MODEL=gpt-4o-mini
# AZURE_OPENAI_DEPLOYMENT=daily-task-agent

# ----------------------------------------
# Azure Cosmos DB Configuration
# ----------------------------------------
# Used for persistent data storage (users, sessions)
#
# HOW TO SET UP:
# 1. Azure Portal → Create "Azure Cosmos DB" resource (NoSQL API, Serverless capacity)
# 2. In that resource → Keys → Copy "URI" and "PRIMARY KEY"
# 3. Create Database: gamifai-db
# 4. Create Container: users (partition key: /userId)
# 5. Create Container: sessions (partition key: /sessionId, TTL: 432000)
# 6. Paste values below

COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=your-primary-key
COSMOS_DATABASE=gamifai-db

# Storage mode: 'file' (local JSON), 'cosmos' (Azure Cosmos DB), 'migration' (lazy file→cosmos)
STORAGE_MODE=file

# ========================================
# 📝 Environment-Specific Configurations
# ========================================
#
# .env.development contains:
# - VITE_API_BASE_URL=http://localhost:3001/api
#
# .env.production contains:
# - VITE_API_BASE_URL=/api
#
# These files provide defaults but can be overridden by your .env file
#
# ========================================
# 🚀 After Configuration
# ========================================
#
# 1. Save your .env file
# 2. Restart the development server: npm run start
# 3. Verify the frontend loads at http://localhost:5173
# 4. Verify the backend API at http://localhost:3001/api/health
#
# ========================================