
# Example .env file for Gamif.AI
# Copy this file to .env and fill in your values

# API base URL for backend
# For local development:
VITE_API_BASE_URL=http://localhost:3001/api

# For Codespaces (replace with your Codespaces backend URL):
# VITE_API_BASE_URL=https://turbo-couscous-4v94xq5rg6xfjpgg-3001.app.github.dev/api

# CORS allowed origins for backend
# For local development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# For Codespaces (replace with your Codespaces frontend URL):
# ALLOWED_ORIGINS=https://turbo-couscous-4v94xq5rg6xfjpgg-5173.app.github.dev

# Azure OpenAI Configuration
# Replace with your actual Azure OpenAI API key
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here

# Email Configuration for OTP Verification
# SMTP settings - For Gmail, use smtp.gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Your email address
EMAIL_USER=your-email@gmail.com
# App-specific password (for Gmail: https://myaccount.google.com/apppasswords)
EMAIL_PASSWORD=your-app-specific-password