{
  "version": 1,
  "version_date": "2026-05-17",
  "description": "Universal activity template library. Each row is a domain-neutral activity type with a floor rate (XP/shards at difficulty 1). A user's personal catalog instantiates a subset of these templates with rates scaled by their intake difficulty score. The activity-extraction prompt maps natural-language descriptions (e.g. 'did 5 leetcode problems', 'worked on a sudoku') to these generic templates.",
  "rate_formula": {
    "personal_rate": "floor × (0.75 + intake_difficulty × 0.25)",
    "difficulty_range": [1, 5],
    "personal_multiplier_at_difficulty_1": 1.0,
    "personal_multiplier_at_difficulty_5": 2.0
  },
  "modifier_meanings": {
    "intensity": "Physical exertion or effort level. light / moderate / intense.",
    "focus": "Cognitive engagement depth. passive / focused / deep.",
    "difficulty": "Task complexity or challenge level. easy / moderate / hard.",
    "audience_familiarity": "Relationship to audience or counterpart. friend / acquaintance / stranger / unfamiliar.",
    "audience_size": "Group size for presentations or speaking. small_group / large_audience / unfamiliar_audience.",
    "flat": "No modifier dimension; reward is fixed per occurrence."
  },
  "global_rules": {
    "category_daily_xp_cap": 80,
    "inferred_effort_penalty": 0.85,
    "auto_added_provisional_until_uses": 5
  },
