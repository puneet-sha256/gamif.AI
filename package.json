{
  "name": "solo-leveling",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "tsx server.ts",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "build:server": "tsc -p tsconfig.node.json",
    "build:client": "vite build",
    "dev:server": "tsx watch server.ts",
    "dev": "vite",
    "copy:prompts": "shx mkdir -p build/src/server/prompts && shx cp -r src/server/prompts/* build/src/server/prompts/",
    "copy:data": "shx mkdir -p build/src/server/data && shx cp -r src/server/data/* build/src/server/data/",
    "build": "npm run build:server && npm run copy:prompts && npm run copy:data && npm run build:client",
    "start": "node build/server.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@azure/ai-projects": "^1.0.0",
    "@azure/communication-email": "^1.1.0",
    "@azure/cosmos": "^4.9.1",
    "@azure/identity": "^4.12.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "emoji-picker-react": "^4.15.1",
    "express": "^5.1.0",
    "fs-extra": "^11.3.1",
    "openai": "^6.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "shx": "^0.4.0",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  }
}
