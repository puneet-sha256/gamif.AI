{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "outDir": "build",
    "rootDir": ".",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": false,
    "lib": ["ES2022"]
  },
  "include": [
    "server.ts",
    "src/server/**/*.ts",
    "src/utils/logger.ts",             // <- include only server-safe utils
    "src/utils/streakCalculation.ts",   // <- used by notification scheduler
    "src/shared/types/**/*.ts"
  ],
  "exclude": [
    "src/**/*.tsx",
    "src/client/**/*",
    "src/components/**/*",
    "src/contexts/**/*",
    "src/utils/soundEffects.ts"        // <- exclude browser-only util
  ]
}
